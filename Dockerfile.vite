# Development image for the Vite dev server (HMR for the Inertia + React frontend).
# Production assets are built and deployed via .github/workflows, so this image
# is only meant for local development (see devstack.tobias-hopp.de).

FROM node:22-alpine

WORKDIR /app

# Install dependencies first so this layer is cached unless package*.json changes.
COPY package.json package-lock.json ./
RUN npm ci

# Copy the rest of the source (overridden by the bind mount in docker-compose.yml at runtime).
COPY . .

EXPOSE 5174

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5174"]
